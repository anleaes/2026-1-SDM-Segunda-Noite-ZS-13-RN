# Copie para .env e ajuste o IP do seu computador na rede local.
# Celular fisico: use o IP da maquina onde o Django roda (nao localhost).
# Emulador iOS: http://127.0.0.1:8000/api
# Emulador Android: http://10.0.2.2:8000/api (padrao automatico se nao definir)
EXPO_PUBLIC_API_URL=http://192.168.0.100:8000/api
